  shorttitle = {Associations between Social Media Use and Loneliness in a Cross-National Population},
  author = {Bonsaksen, Tore and Ruffolo, Mary and Price, Daicia and Leung, Janni and Thygesen, Hilde and Lamph, Gary and Kabelenga, Isaac and Geirdal, Amy Østertun},
  journaltitle = {Health Psychology and Behavioral Medicine},
